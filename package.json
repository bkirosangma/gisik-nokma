{
  "name": "gisik-nokma",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.0.0 <23"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "check:env": "node scripts/check-env-example.mjs",
    "check:tasks": "node scripts/check-task-ledger.mjs",
    "check:db-tz": "node scripts/check-db-timezone.mjs",
    "check:migrations": "node scripts/check-migration-order.mjs",
    "check:ctl": "bash scripts/ctl/ctl selftest",
    "test:e2e:stack": "pnpm --filter @gisik-nokma/web run test:e2e:stack",
  "test:e2e:viewport": "pnpm --filter @gisik-nokma/web run test:e2e:viewport",
    "dev:stack": "docker compose --env-file .env -f docker-compose.dev.yml up -d server web",
    "dev:stack:rebuild": "docker compose --env-file .env -f docker-compose.dev.yml up -d --build server web",
    "check:runbook": "node scripts/check-runbook-commands.mjs",
    "check:citations": "node scripts/check-case-citations.mjs",
    "help:generate": "node scripts/help-content.mjs",
    "check:help": "node scripts/help-content.mjs --check"
  },
  "devDependencies": {
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "pg": "^8.13.0",
    "turbo": "^2.5.0"
  }
}
