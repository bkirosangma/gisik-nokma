{
  "name": "@gisik-nokma/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NEXT_TELEMETRY_DISABLED=1 next dev -p 3001",
    "build": "NEXT_TELEMETRY_DISABLED=1 next build",
    "start": "NEXT_TELEMETRY_DISABLED=1 next start -p 3001",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.e2e.json --noEmit",
    "test:e2e:stack": "playwright test -c playwright.stack.config.ts",
    "test:e2e:viewport": "playwright test -c playwright.viewport.config.ts"
  },
  "dependencies": {
    "@better-auth/passkey": "^1.7.2",
    "@gisik-nokma/app-core": "workspace:*",
    "@gisik-nokma/domain": "workspace:*",
    "@gisik-nokma/editor": "workspace:*",
    "@gisik-nokma/ui": "workspace:*",
    "better-auth": "^1.7.2",
    "next": "^15.1.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.3",
    "vitest": "^3.1.0"
  }
}
