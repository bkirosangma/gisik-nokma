{
  "name": "@gisik-nokma/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "dev": "tsx src/index.ts",
    "migrate": "node-pg-migrate up --migrations-dir migrations",
    "verify:projections": "tsx src/tools/verify-projections.ts",
    "rebuild:projection": "tsx src/tools/rebuild-projection.ts",
    "auth:schema": "tsx src/tools/auth-schema.ts",
    "search:preflight": "tsx src/tools/search-preflight.ts",
    "sweep:notifications": "tsx src/tools/sweep-notifications.ts",
    "sweep:invite-tokens": "tsx src/tools/sweep-invite-tokens.ts",
    "sweep:user-preferences": "tsx src/tools/sweep-user-preferences.ts",
    "sweep:orphans": "tsx src/tools/sweep-orphans.ts",
    "seed:cc": "tsx src/seed/cli-seed-convenience-corner.ts",
    "seed:dev": "tsx src/seed/cli-seed-dev-workspace.ts",
    "seed:search-corpus": "tsx src/tools/seed-search-corpus.ts",
    "semantic:measure": "tsx src/tools/measure-semantic.ts",
    "ops:backup-once": "tsx src/ops/backup-daemon-main.ts --once",
    "ops:fetch-backup": "tsx src/ops/fetch-backup.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/lib-storage": "^3.700.0",
    "@better-auth/passkey": "^1.7.2",
    "@fastify/compress": "^8.0.0",
    "@fastify/cors": "^11.3.0",
    "@fastify/multipart": "^9.0.0",
    "@fastify/websocket": "^11.0.0",
    "@gisik-nokma/domain": "workspace:*",
    "@gisik-nokma/mcp-server": "workspace:*",
    "@gisik-nokma/rule-engine": "workspace:*",
    "@huggingface/tokenizers": "^0.2.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "better-auth": "^1.7.2",
    "fastify": "^5.3.0",
    "file-type": "^19.6.0",
    "graphology": "0.26.0",
    "graphology-communities-louvain": "2.0.2",
    "graphology-types": "0.24.8",
    "node-pg-migrate": "^7.9.0",
    "nodemailer": "^10.0.0",
    "pg": "^8.13.0",
    "ulidx": "^2.4.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@gisik-nokma/app-core": "workspace:*",
    "@gisik-nokma/sync-client": "workspace:*",
    "@huggingface/transformers": "^4.3.0",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.0",
    "@types/ws": "^8.5.0",
    "aws-sdk-client-mock": "^4.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.3",
    "vitest": "^3.1.0",
    "ws": "^8.18.0",
    "yaml": "^2.6.1"
  }
}
