{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023"],
    "jsx": "react-jsx",
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "declaration": false,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["react-native"]
  },
  "include": ["index.ts", "src/**/*"],
  "exclude": ["node_modules"]
}
