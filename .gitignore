.DS_Store
node_modules/
dist/
# packages/editor's RN webview bundle (vite.webview.config.ts outDir): a
# single self-contained index.html, not the package's tsc `dist/` above but
# still a regenerated build artefact, never committed.
dist-webview/
build/
__pycache__/
*.pyc
.env
.env.*
# ...except the contract itself. .env.example documents every variable and
# is what scripts/check-env-example.mjs checks code against; the .env.* rule
# above would otherwise silently keep it out of the repo.
!.env.example
.turbo/
.next/
*.tsbuildinfo
coverage/
# Playwright's own output: a run's HTML report and its per-failure traces and
# screenshots. Both are artefacts of `test:e2e`, which is not on the gate; the
# report directory in particular is regenerated whole on every run.
test-results/
playwright-report/
.superpowers/

# graphify: derived structural graph. Rebuilt from source in ~1 min at zero LLM cost
# (code-only corpora skip semantic extraction), so it is regenerated, never shared.
# Each worktree keeps its own, which is correct: they sit on different branches.
graphify-out/

# Local-disk ObjectStore root (apps/server/src/attachments/local-disk-store.ts,
# default var/attachments): dev/test attachment bytes, never committed.
var/

# Tauri/Cargo build output (apps/desktop, Task 16): compiled crates and the
# schema/bindings tauri-build regenerates every build. `**/` rather than a
# bare name — an unanchored `src-tauri/gen/` would anchor to this file's own
# directory and never match a nested app.
**/src-tauri/target/
**/src-tauri/gen/

# Gate runs write here (lock protocol v3.2). A build artefact, never a commit:
# `git add -A` swept it into two commits on exec/31 before this line existed.
gate.log
gate*.log

# Lane scratch space (dev-stack screenshots, one-off working notes) — never
# under version control (docs/held-work.md's own convention: briefs written
# here are copied to docs/lanes/held/ precisely because this directory isn't
# tracked). Explicit here so a lane's evidence screenshots don't read as an
# uncommitted-work dirty tree to `ctl pr open`'s own check.
gisik-nokma-lanes/

# Claude Code agent worktrees (a committed gitlink here broke CI checkout post-job: no .gitmodules entry)
.claude/worktrees/

# flow-graph-browser: stress records the harness appends through its /__results endpoint (a real-phone run writes here too)
packages/flow-graph-browser/results/
