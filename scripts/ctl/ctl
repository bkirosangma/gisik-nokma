#!/usr/bin/env bash
# scripts/ctl/ctl — the one door for the controller's mechanical work. `ctl help` lists the verbs; `ctl <verb> … --help` prints one.
set -u
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
help_text() {
    cat <<'HELP'
usage: scripts/ctl/ctl <verb> [--repo <worktree>] [--dry-run] [args]
  checks                          the eight checks + two non-zero controls
  gate <sha> [--base B]           forced gate at HEAD=<sha>; writes the gate marker (B = main | release/<name>)
  tipmerge <branch> --base B --expect <sha>  clean tip merge of origin/B into <branch> with no checkout (exit 3 = conflicted)
  batch <release/name> <pr> <pr> [<pr> <pr>]  gate 2-4 READY PRs as ONE union in the batch tree, land it green (exit 3 = gate singly)
  pr open <branch> --title T --body FILE [--require-checked]
  land <pr> [--base B]            comment gate, merge head-gated, verify, ff primary (PR base must equal B)
  anchor <N> --title T --body FILE
  check-pr <branch> [--plan FILE] [--base B]  mechanical batch-PR verification; writes the checked marker
  reconcile                       ledger vs report headings by membership + plan coverage
  lanes [--watch]                 one line per gisik: window
  seats [--json] [--flag]         one line per seat: busy/idle, shells+monitors, input box, Ctx, branch, last DONE/CHECKPOINT (read-only; --flag = only seats needing action)
  check-base <branch> <stated-base>  WRONG-BASE (exit 1) when another origin/release/* or main reaches the branch's first-parent line nearer the tip than the base a REVIEW line states
  bundle-fresh [--base B] [--fix]  on a domain/editor/lockfile diff vs origin/B: build + build:webview + the mobile bundle --check in ONE slot (exit 1 STALE);
                                  --fix regenerates and commits ONLY the bundle file; no such diff = SKIP, no slot
  restart <window> <worktree> <brief> [--override FILE] [--model M] [--effort E]
  close <window>                  close an idle lane whose worktree is clean and pushed
  archive [--apply] [--list]      move stale lanes-dir working files to archive/<date>/ + roll the notes (dry-run by default; refuses while a landing is in flight)
  dispatch <window> <file>        two pastes + proof of delivery
  autopilot once|run|start [--shadow]  the matchmaking loop: free reviewers pull queue items, free lanes take their pool's next task (FIX, tip-ready, stack <= 2) or review; --shadow logs WOULD only
  prune-gate-locks [--apply] [--list]  remove gate-lock-* run dirs > 24 h and gate logs > 7 days from the log dir, never a live one (dry-run by default)
  rebuild                         pull --ff-only the primary checkout's own branch (main or release/*),
                                  rebuild the stack from it, verify
  run-tests [--label L] [--max-min N] [--short] -- <cmd…>  run a test/tsc/build command through the machine-wide slot semaphore; output to a log, ≤ 30-line summary; stopped (124 + TIMEOUT) past N min of slot time (default 30); --short may take the express slot
  mutate [--base REF] [--json]    Stryker + numeric ×10/÷10, ceil/floor/round, casts stripped, on the branch's changed lines; one slot-run per file
                                  (exit 0 no survivor, 1 survivors to triage, 2 tool failure; report ~/.cache/gisik-ctl/mutate-<branch>-<sha8>.md)
  post <to> --kind K (--body FILE | --text STR) [--from SEAT] [--reply-to ID]
                                  append a message to roles/LEDGER.jsonl (the postman delivers it)
  inbox [--seat S] [--all] [--watch]  my unacked messages; --watch = the ONE cursor watcher for the seat's Monitor
  ack <id> [--seat S] [--cancel]  receipt for a message (idempotent); stops redelivery
  postman run|once|status|audit|restarted <seat>  the delivery daemon (tmux window `postman`) and its admin
  postman audit --parity|--since T|--window N  shadow parity + retirement condition A; dispatcher lines before 2026-10-03 name the task after the verb
                                  and audit as no-ref: run condition A on windows from 10-03 on
  selftest                        hook table, lib tests, every verb --dry-run
HELP
}
# usage_of VERB: the verb's rows of the help table — a row naming it (`pr-open` is `pr open`; `postman` has two) and the deeper-indented
# lines under each. The table is the usage source: it has a row for every verbs/*.sh (13.2373), the README a section for only some.
usage_of() {
  help_text | awk -v l="$(printf '%s' "$1" | sed 's/^pr-/pr /')" '/^  [^ ]/ { s = substr($0, 3); on = (s == l || index(s, l " ") == 1) } on && /^  /'
}
verb="${1:-help}"; shift || true
case "$verb" in
  pr) case "${1:-}" in -h|--help) verb=pr-open;; *) sub="${1:-}"; shift || true; verb="pr-$sub";; esac;;
esac
case "$verb" in
  help|-h|--help) help_text; exit 0;;
esac
script="$HERE/verbs/$verb.sh"
[ -f "$script" ] || { echo "FAIL ctl unknown verb $verb (see: scripts/ctl/ctl help)"; exit 64; }
# A help probe never acts (P78, 2026-10-06: `ctl rebuild --help` started a real rebuild — a verb acts on arguments it does not know). An
# argument that is exactly --help or -h, anywhere before a `--`, prints the verb's usage and exits 0 without running the verb. After `--`
# comes a command (`ctl run-tests -- <cmd…>`, and slot-run.sh through it), whose own -h is its business (13.2375).
for a in "$@"; do
  case "$a" in
    --) break;;
    --help|-h)
      u="$(usage_of "$verb")"
      if [ -n "$u" ]; then echo "ctl ${verb/#pr-/pr } --help: its rows of \`ctl help\` (scripts/ctl/README.md has more); nothing was run"; printf '%s\n' "$u"
      else echo "ctl $verb: no usage text; read scripts/ctl/README.md"; fi
      exit 0;;
  esac
done
exec bash "$script" "$@"
