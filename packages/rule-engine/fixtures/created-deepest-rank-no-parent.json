{
  "name": "a custom type at the deepest rank is refused at project root, named as itself",
  "notes": "Owner decision 2026-08-20: the parent requirement follows the RANK, not the built-in id — so the refusal names the workspace's own \"Checklist item\", never \"sub-task\". This fixture is what makes that copy provable outside the unit tests.",
  "workflowDefs": [
    {
      "id": "wf-basic", "version": 1, "name": "Basic", "initialStateId": "todo",
      "states": [
        { "id": "todo", "name": "To do", "category": "open" },
        { "id": "doing", "name": "Doing", "category": "active" },
        { "id": "done", "name": "Done", "category": "terminal" }
      ],
      "transitions": [
        { "from": "*", "to": "todo", "rules": [] },
        { "from": "*", "to": "doing", "rules": [] },
        { "from": "*", "to": "done", "rules": [] }
      ]
    }
  ],
  "priorEvents": [
    { "type": "ticket-type.defined", "entity": { "kind": "ticket-type", "id": "story" }, "actorId": "user-kiro",
      "payload": { "id": "story", "name": "Story", "icon": "book", "rank": 2, "workflowId": "wf-basic", "fields": [] } },
    { "type": "ticket-type.defined", "entity": { "kind": "ticket-type", "id": "task" }, "actorId": "user-kiro",
      "payload": { "id": "task", "name": "Task", "icon": "check", "rank": 3, "workflowId": "wf-basic", "fields": [] } },
    { "type": "ticket-type.defined", "entity": { "kind": "ticket-type", "id": "checklist-item" }, "actorId": "user-kiro",
      "payload": { "id": "checklist-item", "name": "Checklist item", "icon": "list", "rank": 4, "workflowId": "wf-basic", "fields": [] } },
    { "type": "ticket.created", "entity": { "kind": "ticket", "id": "01J9GPAR000000000000000000" }, "actorId": "user-kiro",
      "payload": { "typeId": "story", "projectId": "01J9GPRJ000000000000000000", "parentId": null, "title": "Shop compliance", "workflowId": "wf-basic" } }
  ],
  "candidateEvent": {
    "type": "ticket.created", "entity": { "kind": "ticket", "id": "01J9GNEW000000000000000000" }, "actorId": "user-kiro",
    "payload": { "typeId": "checklist-item", "projectId": "01J9GPRJ000000000000000000", "parentId": null, "title": "Photograph the renewed licence" }
  },
  "expected": {
    "refused": true,
    "rule": "hierarchy.deepest-rank-parent-required",
    "reason": "\"Checklist item\" is the smallest kind of work, so it always belongs to a parent ticket. Pick the ticket this one is part of."
  }
}
