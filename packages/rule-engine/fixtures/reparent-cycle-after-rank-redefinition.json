    { "type": "ticket.created", "entity": { "kind": "ticket", "id": "01J9GTKB000000000000000000" }, "actorId": "user-kiro",
      "payload": { "typeId": "step", "projectId": "01J9GPRJ000000000000000000", "parentId": "01J9GTKA000000000000000000", "title": "Order the counter", "workflowId": "wf-basic" } },
    { "type": "ticket-type.defined", "entity": { "kind": "ticket-type", "id": "phase" }, "actorId": "user-kiro",
