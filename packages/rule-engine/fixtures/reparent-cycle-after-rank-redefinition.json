        { "id": "done", "name": "Done", "category": "terminal" }
      ],
      "transitions": [
        { "from": "*", "to": "todo", "rules": [] },
        { "from": "*", "to": "doing", "rules": [] },
        { "from": "*", "to": "done", "rules": [] }
      ]
    }
  ],
  "priorEvents": [
