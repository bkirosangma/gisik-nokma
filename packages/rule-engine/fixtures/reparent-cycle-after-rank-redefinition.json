      "payload": { "id": "phase", "name": "Phase", "icon": "flag", "rank": 1, "workflowId": "wf-basic", "fields": [] } },
    { "type": "ticket-type.defined", "entity": { "kind": "ticket-type", "id": "step" }, "actorId": "user-kiro",
      "payload": { "id": "step", "name": "Step", "icon": "check", "rank": 2, "workflowId": "wf-basic", "fields": [] } },
    { "type": "ticket.created", "entity": { "kind": "ticket", "id": "01J9GTKA000000000000000000" }, "actorId": "user-kiro",
